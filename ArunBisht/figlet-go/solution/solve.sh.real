#!/usr/bin/env bash
set -e

mkdir -p /workspace/repo/fonts
cp /workspace/repo/pyfiglet/fonts/*.flf /workspace/repo/fonts/

find /workspace/repo -name "*.py" -delete

cat > /workspace/repo/go.mod <<'EOF'
module figlet

go 1.23
EOF

cat > /workspace/repo/main.go <<'EOF'
package main

import (
	"embed"
	"fmt"
	"io"
	"os"
	"strconv"
	"strings"
	"unicode"
	"unicode/utf8"
)

//go:embed fonts/*.flf
var fontFiles embed.FS

type font struct {
	name      string
	height    int
	hardBlank rune
	printDir  int
	smushMode int
	chars     map[rune][]string
	widths    map[rune]int
}

func parseFont(name string) (*font, error) {
	data, err := fontFiles.ReadFile("fonts/" + name + ".flf")
	if err != nil {
		return nil, fmt.Errorf("font %q not found", name)
	}
	text := strings.NewReplacer("\u0085", " ", "\u2028", " ", "\u2029", " ").Replace(string(data))
	lines := strings.Split(text, "\n")
	if len(lines) > 0 && lines[len(lines)-1] == "" {
		lines = lines[:len(lines)-1]
	}
	for i := range lines {
		lines[i] = strings.TrimSuffix(lines[i], "\r")
	}
	if len(lines) == 0 || len(lines[0]) < 5 || (lines[0][:5] != "flf2a" && lines[0][:5] != "tlf2a") {
		return nil, fmt.Errorf("%s is not a valid figlet font", name)
	}
	header := strings.Fields(lines[0][5:])
	if len(header) < 6 {
		return nil, fmt.Errorf("malformed header for %s", name)
	}
	values := make([]int, 5)
	for i := range values {
		values[i], err = strconv.Atoi(header[i+1])
		if err != nil {
			return nil, fmt.Errorf("malformed header for %s", name)
		}
	}
	height, oldLayout, comments := values[0], values[3], values[4]
	if height <= 0 || comments < 0 || len(lines) < 1+comments {
		return nil, fmt.Errorf("malformed header for %s", name)
	}
	hardRunes := []rune(header[0])
	if len(hardRunes) == 0 {
		return nil, fmt.Errorf("malformed hardblank for %s", name)
	}
	printDir := -1
	if len(header) > 6 {
		printDir, _ = strconv.Atoi(header[6])
	}
	smushMode := 0
	if len(header) > 7 {
		smushMode, _ = strconv.Atoi(header[7])
	} else if oldLayout == 0 {
		smushMode = 64
	} else if oldLayout > 0 {
		smushMode = (oldLayout & 31) | 128
	}
	lineIndex := 1 + comments
	parsed := &font{name: name, height: height, hardBlank: hardRunes[0], printDir: printDir, smushMode: smushMode, chars: map[rune][]string{}, widths: map[rune]int{}}
	readChar := func() ([]string, int, error) {
		if lineIndex+height > len(lines) {
			return nil, 0, io.ErrUnexpectedEOF
		}
		glyph := make([]string, height)
		maxWidth := 0
		var marker rune
		for row := 0; row < height; row++ {
			line := lines[lineIndex]
			lineIndex++
			if row == 0 {
				trimmed := strings.TrimRightFunc(line, unicode.IsSpace)
				if trimmed == "" {
					return nil, 0, fmt.Errorf("missing end marker")
				}
				marker, _ = utf8.DecodeLastRuneInString(trimmed)
			}
			trimmed := strings.TrimRightFunc(line, unicode.IsSpace)
			runes := []rune(trimmed)
			for count := 0; count < 2 && len(runes) > 0 && runes[len(runes)-1] == marker; count++ {
				runes = runes[:len(runes)-1]
			}
			glyph[row] = string(runes)
			if len(runes) > maxWidth {
				maxWidth = len(runes)
			}
		}
		return glyph, maxWidth, nil
	}
	for code := rune(32); code <= 126; code++ {
		glyph, width, readErr := readChar()
		if readErr != nil {
			return nil, fmt.Errorf("problem parsing %s font: %w", name, readErr)
		}
		if code == 32 || strings.Join(glyph, "") != "" {
			parsed.chars[code] = glyph
			parsed.widths[code] = width
		}
	}
	if lineIndex < len(lines) {
		for _, code := range []rune("ÄÖÜäöüß") {
			glyph, width, readErr := readChar()
			if readErr != nil {
				return nil, fmt.Errorf("problem parsing %s font: %w", name, readErr)
			}
			if strings.Join(glyph, "") != "" {
				parsed.chars[code] = glyph
				parsed.widths[code] = width
			}
		}
	}
	for lineIndex < len(lines) {
		line := strings.TrimSpace(lines[lineIndex])
		lineIndex++
		if line == "" {
			continue
		}
		tag := strings.Fields(line)[0]
		if len(tag) < 2 || !strings.EqualFold(tag[:2], "0x") {
			continue
		}
		code, parseErr := strconv.ParseInt(tag[2:], 16, 32)
		if parseErr != nil {
			continue
		}
		glyph, width, readErr := readChar()
		if readErr != nil {
			return nil, fmt.Errorf("problem parsing %s font: %w", name, readErr)
		}
		if strings.Join(glyph, "") != "" {
			parsed.chars[rune(code)] = glyph
			parsed.widths[rune(code)] = width
		}
	}
	return parsed, nil
}

const (
	smEqual     = 1
	smLowline   = 2
	smHierarchy = 4
	smPair      = 8
	smBigX      = 16
	smHardblank = 32
	smKern      = 64
	smSmush     = 128
)

type builder struct {
	text       []rune
	font       *font
	direction  string
	width      int
	justify    string
	iterator   int
	maxSmush   int
	curWidth   int
	prevWidth  int
	buffer     []string
	product    [][]string
	blankMarks []blankMark
}

type blankMark struct {
	buffer   []string
	iterator int
}

func newBuilder(text string, f *font, direction string, width int, justify string) *builder {
	return &builder{text: []rune(text), font: f, direction: direction, width: width, justify: justify, buffer: make([]string, f.height)}
}

func (b *builder) charAt(index int) ([]string, int, bool) {
	if index < 0 || index >= len(b.text) {
		return nil, 0, false
	}
	glyph, exists := b.font.chars[b.text[index]]
	if !exists {
		return nil, 0, false
	}
	return glyph, b.font.widths[b.text[index]], true
}

func (b *builder) smushChars(left, right rune) (rune, bool) {
	if left == ' ' {
		return right, true
	}
	if right == ' ' {
		return left, true
	}
	if b.prevWidth < 2 || b.curWidth < 2 || b.font.smushMode&smSmush == 0 {
		return 0, false
	}
	if b.font.smushMode&63 == 0 {
		if left == b.font.hardBlank { return right, true }
		if right == b.font.hardBlank { return left, true }
		if b.direction == "right-to-left" { return left, true }
		return right, true
	}
	if b.font.smushMode&smHardblank != 0 && left == b.font.hardBlank && right == b.font.hardBlank {
		return left, true
	}
	if left == b.font.hardBlank || right == b.font.hardBlank { return 0, false }
	if b.font.smushMode&smEqual != 0 && left == right { return left, true }
	if b.font.smushMode&smLowline != 0 {
		leftGroup, rightGroup := "_", "|/\\[]{}()<>"
		if strings.ContainsRune(leftGroup, left) && strings.ContainsRune(rightGroup, right) { return right, true }
		if strings.ContainsRune(leftGroup, right) && strings.ContainsRune(rightGroup, left) { return left, true }
	}
	if b.font.smushMode&smHierarchy != 0 {
		groups := [][2]string{{"|", "/\\[]{}()<>"}, {"/\\", "[]{}()<>"}, {"[]", "{}()<>"}, {"{}", "()<>"}, {"()", "<>"}}
		for _, group := range groups {
			if strings.ContainsRune(group[0], left) && strings.ContainsRune(group[1], right) { return right, true }
			if strings.ContainsRune(group[0], right) && strings.ContainsRune(group[1], left) { return left, true }
		}
	}
	if b.font.smushMode&smPair != 0 {
		pair, reversed := string([]rune{left, right}), string([]rune{right, left})
		if pair == "[]" || pair == "{}" || pair == "()" || reversed == "[]" || reversed == "{}" || reversed == "()" { return '|', true }
	}
	if b.font.smushMode&smBigX != 0 {
		if left == '/' && right == '\\' { return '|', true }
		if right == '/' && left == '\\' { return 'Y', true }
		if left == '>' && right == '<' { return 'X', true }
	}
	return 0, false
}

func (b *builder) smushAmount(glyph []string, charWidth int) int {
	if b.font.smushMode&(smSmush|smKern) == 0 { return 0 }
	maxSmush := charWidth
	for row := 0; row < b.font.height; row++ {
		left, right := []rune(b.buffer[row]), []rune(glyph[row])
		if b.direction == "right-to-left" { left, right = right, left }
		leftBoundary := len(left) - 1
		for leftBoundary >= 0 && left[leftBoundary] == ' ' { leftBoundary-- }
		if leftBoundary < 0 { leftBoundary = 0 }
		leftChar := rune(0)
		if leftBoundary < len(left) { leftChar = left[leftBoundary] } else { leftBoundary = 0 }
		rightBoundary := 0
		for rightBoundary < len(right) && right[rightBoundary] == ' ' { rightBoundary++ }
		rightChar := rune(0)
		if rightBoundary < len(right) { rightChar = right[rightBoundary] } else { rightBoundary = len(right) }
		amount := rightBoundary + len(left) - 1 - leftBoundary
		if leftChar == 0 || leftChar == ' ' { amount++
		} else if rightChar != 0 {
			if _, ok := b.smushChars(leftChar, rightChar); ok { amount++ }
		}
		if amount < maxSmush { maxSmush = amount }
	}
	return maxSmush
}

func copyRows(rows []string) []string { return append([]string(nil), rows...) }

func (b *builder) addGlyph(glyph []string, width int) {
	b.curWidth = width
	b.maxSmush = b.smushAmount(glyph, width)
	for row := 0; row < b.font.height; row++ {
		left, right := []rune(b.buffer[row]), []rune(glyph[row])
		if b.direction == "right-to-left" { left, right = right, left }
		for i := 0; i < b.maxSmush && i < len(right); i++ {
			index := len(left) - b.maxSmush + i
			if index < 0 || index >= len(left) { continue }
			if merged, ok := b.smushChars(left[index], right[i]); ok { left[index] = merged }
		}
		cut := b.maxSmush
		if cut > len(right) { cut = len(right) }
		b.buffer[row] = string(left) + string(right[cut:])
	}
}

func (b *builder) flush() { b.product = append(b.product, copyRows(b.buffer)) }

func (b *builder) reset() {
	b.buffer = make([]string, b.font.height)
	b.blankMarks = nil
	b.prevWidth = 0
	if glyph, width, ok := b.charAt(b.iterator); ok { b.maxSmush = b.smushAmount(glyph, width) }
}

func (b *builder) cutAtBlank(mark blankMark) {
	b.product = append(b.product, copyRows(mark.buffer))
	b.iterator = mark.iterator
	b.reset()
}

func (b *builder) cutAtChar() {
	b.flush()
	b.iterator--
	b.reset()
}

func (b *builder) newline() {
	if len(b.blankMarks) > 0 {
		last := b.blankMarks[len(b.blankMarks)-1]
		b.blankMarks = b.blankMarks[:len(b.blankMarks)-1]
		b.cutAtBlank(last)
	} else {
		b.flush()
		b.reset()
	}
}

func (b *builder) render() string {
	for b.iterator < len(b.text) {
		current := b.text[b.iterator]
		if current == '\n' {
			b.newline()
			b.iterator++
			continue
		}
		glyph, width, ok := b.charAt(b.iterator)
		if !ok { b.iterator++; continue }
		if b.width < width { break }
		b.curWidth = width
		b.maxSmush = b.smushAmount(glyph, width)
		totalWidth := len([]rune(b.buffer[0])) + width - b.maxSmush
		if current == ' ' { b.blankMarks = append(b.blankMarks, blankMark{copyRows(b.buffer), b.iterator}) }
		if totalWidth >= b.width {
			if len(b.blankMarks) > 0 {
				last := b.blankMarks[len(b.blankMarks)-1]
				b.blankMarks = b.blankMarks[:len(b.blankMarks)-1]
				b.cutAtBlank(last)
			} else { b.cutAtChar() }
			b.iterator++
		} else {
			b.addGlyph(glyph, width)
			b.prevWidth = width
			b.iterator++
		}
	}
	if b.buffer[0] != "" { b.flush() }
	var output strings.Builder
	for _, rows := range b.product {
		for _, row := range rows {
			lineWidth := len([]rune(row))
			if b.justify == "right" { row = strings.Repeat(" ", maxInt(0, b.width-lineWidth-1)) + row
			} else if b.justify == "center" { row = strings.Repeat(" ", maxInt(0, (b.width-lineWidth)/2)) + row }
			output.WriteString(strings.ReplaceAll(row, string(b.font.hardBlank), " "))
			output.WriteByte('\n')
		}
	}
	return output.String()
}

func maxInt(a, b int) int { if a > b { return a }; return b }

const reverseMap = "\x00\x01\x02\x03\x04\x05\x06\a\b\t\n\v\f\r\x0e\x0f" +
	"\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f" +
	" !\"#$%&')(*+,-.\\0123456789:;>=<?@ABCDEFGHIJKLMNOPQRSTUVWXYZ]/[^_`abcdefghijklmnopqrstuvwxyz}|{~\x7f" +
	"\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f" +
	"\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f" +
	"\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf" +
	"\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf" +
	"\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf" +
	"\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf" +
	"\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef" +
	"\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

const flipMap = "\x00\x01\x02\x03\x04\x05\x06\a\b\t\n\v\f\r\x0e\x0f" +
	"\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f" +
	" !\"#$%&'()*+,-.\\" +
	"0123456789:;<=>?" +
	"@VBCDEFGHIJKLWNO" +
	"bQbSTUAMXYZ[/]v-" +
	"`aPcdefghijklwno" +
	"pqrstu^mxyz{|}~\x7f" +
	"\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f" +
	"\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f" +
	"\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf" +
	"\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf" +
	"\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf" +
	"\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf" +
	"\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef" +
	"\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

func transformRows(text, table string, reverse bool) string {
	rows := strings.Split(strings.TrimSuffix(text, "\n"), "\n")
	tableRunes := []rune(table)
	for i := range rows {
		runes := []rune(rows[i])
		for j, r := range runes { if r >= 0 && int(r) < len(tableRunes) { runes[j] = tableRunes[int(r)] } }
		if reverse { for left, right := 0, len(runes)-1; left < right; left, right = left+1, right-1 { runes[left], runes[right] = runes[right], runes[left] } }
		rows[i] = string(runes)
	}
	return strings.Join(rows, "\n") + "\n"
}

func stripSurrounding(text string) string {
	rows := strings.Split(text, "\n")
	kept := make([]string, 0, len(rows))
	seen := false
	for _, row := range rows { if strings.TrimSpace(row) != "" || seen { seen = true; kept = append(kept, row) } }
	return strings.TrimRight(strings.Join(kept, "\n"), " \t\r\n\v\f")
}

func main() {
	fontName, justify, direction := "standard", "auto", "auto"
	width := 80
	reverse, flip, stripNewlines, normalizeNewlines := false, false, false, false
	args := os.Args[1:]
	positional := make([]string, 0, len(args))
	for i := 0; i < len(args); i++ {
		arg := args[i]
		value := func(option string) string {
			if strings.Contains(arg, "=") { return strings.SplitN(arg, "=", 2)[1] }
			if i+1 < len(args) { i++; return args[i] }
			fmt.Fprintf(os.Stderr, "missing value for %s\n", option); os.Exit(2); return ""
		}
		switch arg {
		case "-f", "--font": fontName = value(arg)
		case "-w", "--width": parsed, err := strconv.Atoi(value(arg)); if err != nil { fmt.Fprintln(os.Stderr, "invalid width"); os.Exit(2) }; width = parsed
		case "-j", "--justify": justify = value(arg)
		case "-D", "--direction":
			if strings.Contains(arg, "=") { direction = strings.SplitN(arg, "=", 2)[1]
			} else if i+1 < len(args) && (args[i+1] == "auto" || args[i+1] == "left-to-right" || args[i+1] == "right-to-left") { i++; direction = args[i]
			} else { direction = "right-to-left" }
		case "-r", "--reverse": reverse = true
		case "-F", "--flip": flip = true
		case "-s", "--strip-surrounding-newlines": stripNewlines = true
		case "-n", "--normalize-surrounding-newlines": normalizeNewlines = true
		default:
			if strings.HasPrefix(arg, "-f=") { fontName = strings.TrimPrefix(arg, "-f=")
			} else if strings.HasPrefix(arg, "-w=") { parsed, err := strconv.Atoi(strings.TrimPrefix(arg, "-w=")); if err != nil { fmt.Fprintln(os.Stderr, "invalid width"); os.Exit(2) }; width = parsed
			} else if strings.HasPrefix(arg, "-j=") { justify = strings.TrimPrefix(arg, "-j=")
			} else { positional = append(positional, arg) }
		}
	}
	text := strings.Join(positional, " ")
	if len(positional) == 0 { input, err := io.ReadAll(os.Stdin); if err != nil { fmt.Fprintln(os.Stderr, err); os.Exit(1) }; text = string(input) }
	f, err := parseFont(fontName)
	if err != nil { fmt.Fprintln(os.Stderr, "pyfiglet error:", err); os.Exit(1) }
	if direction == "auto" { if f.printDir == 1 { direction = "right-to-left" } else { direction = "left-to-right" } }
	if justify == "auto" || justify == "" { if direction == "right-to-left" { justify = "right" } else { justify = "left" } }
	output := newBuilder(text, f, direction, width, justify).render()
	if reverse { output = transformRows(output, reverseMap, true) }
	if flip {
		output = transformRows(output, flipMap, false)
		rows := strings.Split(strings.TrimSuffix(output, "\n"), "\n")
		for left, right := 0, len(rows)-1; left < right; left, right = left+1, right-1 { rows[left], rows[right] = rows[right], rows[left] }
		output = strings.Join(rows, "\n") + "\n"
	}
	if stripNewlines { output = stripSurrounding(output) } else if normalizeNewlines { output = "\n" + stripSurrounding(output) + "\n" }
	fmt.Print(output)
	fmt.Print("\n")
}
EOF