package main

import (
	"embed"
	"errors"
	"fmt"
	"os"
	"strconv"
	"strings"
	"unicode"
)

//go:embed fonts/*
var fontFiles embed.FS

const defaultFont = "standard"

const (
	smEqual     = 1
	smLowline   = 2
	smHierarchy = 4
	smPair      = 8
	smBigX      = 16
	smHardblank = 32
	smKern      = 64
	smSmush     = 128
)

type glyph struct {
	rows  [][]rune
	width int
}

type figFont struct {
	name           string
	height         int
	hardblank      rune
	printDirection int
	smushMode      int
	glyphs         map[rune]glyph
}

type smushRule struct {
	left  string
	right string
}

func parseFont(name string) (*figFont, error) {
	var content []byte
	var err error
	for _, extension := range []string{"tlf", "flf"} {
		content, err = fontFiles.ReadFile("fonts/" + name + "." + extension)
		if err == nil {
			break
		}
	}
	if err != nil {
		return nil, err
	}

	text := strings.NewReplacer("\u0085", " ", "\u2028", " ", "\u2029", " ").Replace(string(content))
	lines := strings.Split(text, "\n")
	if text == "" {
		lines = nil
	} else if strings.HasSuffix(text, "\n") {
		lines = lines[:len(lines)-1]
	}
	for i := range lines {
		lines[i] = strings.TrimSuffix(lines[i], "\r")
	}
	if len(lines) == 0 || len(lines[0]) < 5 ||
		!(strings.HasPrefix(lines[0], "flf2") || strings.HasPrefix(lines[0], "tlf2")) {
		return nil, fmt.Errorf("%s is not a valid FIGlet font", name)
	}

	fields := strings.Fields(lines[0][5:])
	if len(fields) < 6 {
		return nil, fmt.Errorf("malformed header for %s", name)
	}
	hardblanks := []rune(fields[0])
	if len(hardblanks) == 0 {
		return nil, fmt.Errorf("missing hardblank in %s", name)
	}
	headerNumbers := make([]int, 5)
	for i := range headerNumbers {
		value, parseErr := strconv.Atoi(fields[i+1])
		if parseErr != nil {
			return nil, fmt.Errorf("malformed header for %s: %w", name, parseErr)
		}
		headerNumbers[i] = value
	}
	height, oldLayout, comments := headerNumbers[0], headerNumbers[3], headerNumbers[4]
	if height <= 0 || comments < 0 {
		return nil, fmt.Errorf("invalid header values in %s", name)
	}

	direction := -1
	if len(fields) > 6 {
		direction, err = strconv.Atoi(fields[6])
		if err != nil {
			return nil, fmt.Errorf("invalid print direction in %s: %w", name, err)
		}
	}
	fullLayout := 0
	if len(fields) > 7 {
		fullLayout, err = strconv.Atoi(fields[7])
		if err != nil {
			return nil, fmt.Errorf("invalid full layout in %s: %w", name, err)
		}
	} else if oldLayout == 0 {
		fullLayout = smKern
	} else if oldLayout > 0 {
		fullLayout = oldLayout&31 | smSmush
	}

	font := &figFont{
		name:           name,
		height:         height,
		hardblank:      hardblanks[0],
		printDirection: direction,
		smushMode:      fullLayout,
		glyphs:         make(map[rune]glyph),
	}
	cursor := 1 + comments
	if cursor > len(lines) {
		return nil, fmt.Errorf("truncated comments in %s", name)
	}
	readGlyph := func() (glyph, error) {
		rows := make([][]rune, height)
		width := 0
		var endmark rune
		for row := 0; row < height; row++ {
			if cursor >= len(lines) {
				return glyph{}, errors.New("truncated glyph data")
			}
			line := []rune(strings.TrimRightFunc(lines[cursor], unicode.IsSpace))
			cursor++
			if row == 0 {
				if len(line) == 0 {
					return glyph{}, errors.New("missing glyph endmark")
				}
				endmark = line[len(line)-1]
			}
			if len(line) > 0 && line[len(line)-1] == endmark {
				line = line[:len(line)-1]
				if len(line) > 0 && line[len(line)-1] == endmark {
					line = line[:len(line)-1]
				}
			}
			rows[row] = line
			if len(line) > width {
				width = len(line)
			}
		}
		return glyph{rows: rows, width: width}, nil
	}
	addGlyph := func(code rune, g glyph) {
		var joined strings.Builder
		for _, row := range g.rows {
			joined.WriteString(string(row))
		}
		if code == ' ' || joined.Len() > 0 {
			font.glyphs[code] = g
		}
	}

	for code := rune(32); code <= 126; code++ {
		g, readErr := readGlyph()
		if readErr != nil {
			return nil, fmt.Errorf("problem parsing %s font: %w", name, readErr)
		}
		addGlyph(code, g)
	}
	if cursor < len(lines) {
		for _, code := range []rune("ÄÖÜäöüß") {
			g, readErr := readGlyph()
			if readErr != nil {
				return nil, fmt.Errorf("problem parsing %s font: %w", name, readErr)
			}
			addGlyph(code, g)
		}
	}
	for cursor < len(lines) {
		line := strings.TrimSpace(lines[cursor])
		cursor++
		fields := strings.Fields(line)
		if len(fields) == 0 || len(fields[0]) < 3 || !strings.EqualFold(fields[0][:2], "0x") {
			continue
		}
		code, parseErr := strconv.ParseInt(fields[0][2:], 16, 32)
		if parseErr != nil {
			continue
		}
		g, readErr := readGlyph()
		if readErr != nil {
			return nil, fmt.Errorf("problem parsing %s font: %w", name, readErr)
		}
		addGlyph(rune(code), g)
	}
	return font, nil
}

type blankMarker struct {
	buffer   [][]rune
	iterator int
}

type figletBuilder struct {
	text              []rune
	font              *figFont
	direction         string
	justify           string
	width             int
	iterator          int
	maxSmush          int
	curCharWidth      int
	prevCharWidth     int
	currentTotalWidth int
	blankMarkers      []blankMarker
	product           [][][]rune
	buffer            [][]rune
}

func newBuilder(text string, font *figFont, direction, justify string, width int) *figletBuilder {
	b := &figletBuilder{
		text:      []rune(text),
		font:      font,
		direction: direction,
		justify:   justify,
		width:     width,
		buffer:    make([][]rune, font.height),
	}
	return b
}

func cloneRows(rows [][]rune) [][]rune {
	out := make([][]rune, len(rows))
	for i := range rows {
		out[i] = append([]rune(nil), rows[i]...)
	}
	return out
}

func (b *figletBuilder) charAt(index int) (glyph, bool) {
	if index < 0 || index >= len(b.text) {
		return glyph{}, false
	}
	g, ok := b.font.glyphs[b.text[index]]
	return g, ok
}

func (b *figletBuilder) currentSmushAmount(cur glyph) int {
	return b.smushAmount(b.buffer, cur)
}

func (b *figletBuilder) addCharToProduct() error {
	code := b.text[b.iterator]
	if code == '\n' {
		b.blankMarkers = append(b.blankMarkers, blankMarker{cloneRows(b.buffer), b.iterator})
		b.handleNewLine()
		return nil
	}
	cur, ok := b.charAt(b.iterator)
	if !ok {
		return nil
	}
	if b.width < cur.width {
		return fmt.Errorf("width is not enough to print character %q", code)
	}
	b.curCharWidth = cur.width
	b.maxSmush = b.currentSmushAmount(cur)
	b.currentTotalWidth = len(b.buffer[0]) + b.curCharWidth - b.maxSmush
	if code == ' ' {
		b.blankMarkers = append(b.blankMarkers, blankMarker{cloneRows(b.buffer), b.iterator})
	}
	if b.currentTotalWidth >= b.width {
		b.handleNewLine()
	} else {
		for row := 0; row < b.font.height; row++ {
			b.addCurCharRowToBufferRow(cur, row)
		}
	}
	b.prevCharWidth = b.curCharWidth
	return nil
}

func (b *figletBuilder) cutBufferCommon() {
	b.currentTotalWidth = 0
	b.buffer = make([][]rune, b.font.height)
	b.blankMarkers = nil
	b.prevCharWidth = 0
	cur, ok := b.charAt(b.iterator)
	if !ok {
		return
	}
	b.maxSmush = b.currentSmushAmount(cur)
}

func (b *figletBuilder) cutBufferAtLastBlank(marker blankMarker) {
	b.product = append(b.product, cloneRows(marker.buffer))
	b.iterator = marker.iterator
	b.cutBufferCommon()
}

func (b *figletBuilder) cutBufferAtLastChar() {
	b.product = append(b.product, cloneRows(b.buffer))
	b.iterator--
	b.cutBufferCommon()
}

func (b *figletBuilder) handleNewLine() {
	last := len(b.blankMarkers) - 1
	if last >= 0 {
		marker := b.blankMarkers[last]
		b.blankMarkers = b.blankMarkers[:last]
		b.cutBufferAtLastBlank(marker)
		return
	}
	b.cutBufferAtLastChar()
}

func (b *figletBuilder) addCurCharRowToBufferRow(cur glyph, row int) {
	left := append([]rune(nil), b.buffer[row]...)
	right := cur.rows[row]
	if b.direction == "right-to-left" {
		left, right = append([]rune(nil), right...), left
	}
	for i := 0; i < b.maxSmush; i++ {
		idx := len(left) - b.maxSmush + i
		leftChar := rune(0)
		if idx >= 0 && idx < len(left) {
			leftChar = left[idx]
		}
		rightChar := rune(0)
		if i >= 0 && i < len(right) {
			rightChar = right[i]
		}
		if smushed, ok := b.smushChars(leftChar, rightChar); ok && idx >= 0 && idx < len(left) {
			left[idx] = smushed
		}
	}
	joined := make([]rune, 0, len(left)+len(right))
	joined = append(joined, left...)
	if b.maxSmush < len(right) {
		joined = append(joined, right[b.maxSmush:]...)
	}
	b.buffer[row] = joined
}

func (b *figletBuilder) smushAmount(buffer [][]rune, cur glyph) int {
	if b.font.smushMode&(smSmush|smKern) == 0 {
		return 0
	}
	maxSmush := b.curCharWidth
	for row := 0; row < b.font.height; row++ {
		left, right := buffer[row], cur.rows[row]
		if b.direction == "right-to-left" {
			left, right = right, left
		}
		linebd := len(trimRightSpaces(left)) - 1
		if linebd < 0 {
			linebd = 0
		}
		var ch1 rune
		if linebd < len(left) {
			ch1 = left[linebd]
		} else {
			linebd = 0
		}
		charbd := len(right) - len(trimLeftSpaces(right))
		var ch2 rune
		if charbd < len(right) {
			ch2 = right[charbd]
		} else {
			charbd = len(right)
		}
		amount := charbd + len(left) - 1 - linebd
		if ch1 == 0 || ch1 == ' ' {
			amount++
		} else if ch2 != 0 {
			if _, ok := b.smushChars(ch1, ch2); ok {
				amount++
			}
		}
		if amount < maxSmush {
			maxSmush = amount
		}
	}
	return maxSmush
}

func trimRightSpaces(s []rune) []rune {
	end := len(s)
	for end > 0 && s[end-1] == ' ' {
		end--
	}
	return s[:end]
}

func trimLeftSpaces(s []rune) []rune {
	start := 0
	for start < len(s) && s[start] == ' ' {
		start++
	}
	return s[start:]
}

func containsRune(chars string, r rune) bool {
	return strings.ContainsRune(chars, r)
}

func (b *figletBuilder) smushChars(left, right rune) (rune, bool) {
	if left == ' ' {
		return right, true
	}
	if right == ' ' {
		return left, true
	}
	if b.prevCharWidth < 2 || b.curCharWidth < 2 {
		return 0, false
	}
	if b.font.smushMode&smSmush == 0 {
		return 0, false
	}
	if b.font.smushMode&63 == 0 {
		if left == b.font.hardblank {
			return right, true
		}
		if right == b.font.hardblank {
			return left, true
		}
		if b.direction == "right-to-left" {
			return left, true
		}
		return right, true
	}
	if b.font.smushMode&smHardblank != 0 && left == b.font.hardblank && right == b.font.hardblank {
		return left, true
	}
	if left == b.font.hardblank || right == b.font.hardblank {
		return 0, false
	}
	if b.font.smushMode&smEqual != 0 && left == right {
		return left, true
	}

	rules := []smushRule{}
	if b.font.smushMode&smLowline != 0 {
		rules = append(rules, smushRule{"_", "|/\\[]{}()<>"})
	}
	if b.font.smushMode&smHierarchy != 0 {
		rules = append(rules,
			smushRule{"|", "/\\[]{}()<>"},
			smushRule{"\\/", "[]{}()<>"},
			smushRule{"[]", "{}()<>"},
			smushRule{"{}", "()<>"},
			smushRule{"()", "<>"},
		)
	}
	for _, rule := range rules {
		if containsRune(rule.left, left) && containsRune(rule.right, right) {
			return right, true
		}
		if containsRune(rule.left, right) && containsRune(rule.right, left) {
			return left, true
		}
	}
	if b.font.smushMode&smPair != 0 {
		if (left == '[' && right == ']') || (left == ']' && right == '[') ||
			(left == '{' && right == '}') || (left == '}' && right == '{') ||
			(left == '(' && right == ')') || (left == ')' && right == '(') {
			return '|', true
		}
	}
	if b.font.smushMode&smBigX != 0 {
		if left == '/' && right == '\\' {
			return '|', true
		}
		if right == '/' && left == '\\' {
			return 'Y', true
		}
		if left == '>' && right == '<' {
			return 'X', true
		}
	}
	return 0, false
}

func (b *figletBuilder) render() (string, error) {
	for b.iterator < len(b.text) {
		if err := b.addCharToProduct(); err != nil {
			return "", err
		}
		b.iterator++
	}
	if len(b.buffer) > 0 && len(b.buffer[0]) > 0 {
		b.product = append(b.product, cloneRows(b.buffer))
	}
	var output strings.Builder
	for _, buffer := range b.product {
		for row := range buffer {
			switch b.justify {
			case "right":
				padding := b.width - len(buffer[row]) - 1
				if padding > 0 {
					buffer[row] = prependSpaces(buffer[row], padding)
				}
			case "center":
				padding := (b.width - len(buffer[row])) / 2
				if padding > 0 {
					buffer[row] = prependSpaces(buffer[row], padding)
				}
			}
		}
		for _, row := range buffer {
			for _, r := range row {
				if r == b.font.hardblank {
					r = ' '
				}
				output.WriteRune(r)
			}
			output.WriteByte('\n')
		}
	}
	return output.String(), nil
}

func prependSpaces(row []rune, count int) []rune {
	padded := make([]rune, count, count+len(row))
	for i := range padded {
		padded[i] = ' '
	}
	return append(padded, row...)
}

type options struct {
	font      string
	direction string
	justify   string
	width     int
	reverse   bool
	flip      bool
	strip     bool
	normalize bool
}

func parseOptions(args []string) (options, []string, error) {
	opts := options{font: defaultFont, direction: "auto", justify: "auto", width: 80}
	var text []string
	parseFlags := true
	for i := 0; i < len(args); i++ {
		arg := args[i]
		if parseFlags && arg == "--" {
			parseFlags = false
			continue
		}
		if !parseFlags || !strings.HasPrefix(arg, "-") || arg == "-" {
			text = append(text, arg)
			continue
		}
		key, value, hasValue := strings.Cut(arg, "=")
		switch key {
		case "-f", "--font", "-w", "--width", "-j", "--justify", "-D", "--direction":
			if !hasValue {
				i++
				if i >= len(args) {
					return opts, nil, fmt.Errorf("missing value for %s", key)
				}
				value = args[i]
			}
			switch key {
			case "-f", "--font":
				opts.font = value
			case "-w", "--width":
				width, err := strconv.Atoi(value)
				if err != nil {
					return opts, nil, fmt.Errorf("invalid width %q", value)
				}
				opts.width = width
			case "-j", "--justify":
				opts.justify = value
			case "-D", "--direction":
				opts.direction = value
			}
		case "-r", "--reverse":
			opts.reverse = true
		case "-F", "--flip":
			opts.flip = true
		case "-s", "--strip-surrounding-newlines":
			opts.strip = true
		case "-n", "--normalize-surrounding-newlines":
			opts.normalize = true
		default:
			return opts, nil, fmt.Errorf("unknown option %s", arg)
		}
	}
	if opts.width <= 0 {
		return opts, nil, fmt.Errorf("width must be positive")
	}
	if opts.justify != "auto" && opts.justify != "left" && opts.justify != "center" && opts.justify != "right" {
		return opts, nil, fmt.Errorf("invalid justification %q", opts.justify)
	}
	if opts.direction != "auto" && opts.direction != "left-to-right" && opts.direction != "right-to-left" {
		return opts, nil, fmt.Errorf("invalid direction %q", opts.direction)
	}
	return opts, text, nil
}

func mirrorRows(text string, flip bool) string {
	rows := splitLines(text)
	if flip {
		for i, j := 0, len(rows)-1; i < j; i, j = i+1, j-1 {
			rows[i], rows[j] = rows[j], rows[i]
		}
	}
	reverseMap := map[rune]rune{
		'(': ')', ')': '(', '/': '\\', '\\': '/', '<': '>', '>': '<',
		'[': ']', ']': '[', '{': '}', '}': '{',
	}
	flipMap := map[rune]rune{
		'/': '\\', '\\': '/', 'A': 'V', 'M': 'W', 'P': 'b', 'R': 'b',
		'V': 'A', 'W': 'M', '^': 'v', '_': '-', 'b': 'P', 'm': 'w',
		'v': '^', 'w': 'm',
	}
	mapping := reverseMap
	if flip {
		mapping = flipMap
	}
	for i, row := range rows {
		runes := []rune(row)
		for j, r := range runes {
			if mapped, ok := mapping[r]; ok {
				runes[j] = mapped
			}
		}
		if !flip {
			for left, right := 0, len(runes)-1; left < right; left, right = left+1, right-1 {
				runes[left], runes[right] = runes[right], runes[left]
			}
		}
		rows[i] = string(runes)
	}
	return strings.Join(rows, "\n") + "\n"
}

func splitLines(text string) []string {
	if text == "" {
		return nil
	}
	return strings.Split(strings.TrimSuffix(text, "\n"), "\n")
}

func stripSurroundingNewlines(text string) string {
	var rows []string
	charsSeen := false
	for _, row := range splitLines(text) {
		if strings.TrimSpace(row) != "" || charsSeen {
			charsSeen = true
			rows = append(rows, row)
		}
	}
	return strings.TrimRightFunc(strings.Join(rows, "\n"), unicode.IsSpace)
}

func run(args []string) int {
	opts, textArgs, err := parseOptions(args)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 2
	}
	if len(textArgs) == 0 {
		fmt.Fprintln(os.Stderr, "text required")
		return 1
	}
	font, err := parseFont(opts.font)
	if err != nil {
		fmt.Fprintf(os.Stdout, "pyfiglet error: requested font %q not found.\n", opts.font)
		return 1
	}
	direction := opts.direction
	if direction == "auto" {
		if font.printDirection == 1 {
			direction = "right-to-left"
		} else {
			direction = "left-to-right"
		}
	}
	justify := opts.justify
	if justify == "auto" {
		if direction == "right-to-left" {
			justify = "right"
		} else {
			justify = "left"
		}
	}
	rendered, err := newBuilder(strings.Join(textArgs, " "), font, direction, justify, opts.width).render()
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		return 1
	}
	if opts.reverse {
		rendered = mirrorRows(rendered, false)
	}
	if opts.flip {
		rendered = mirrorRows(rendered, true)
	}
	if opts.strip {
		rendered = stripSurroundingNewlines(rendered)
	} else if opts.normalize {
		rendered = "\n" + stripSurroundingNewlines(rendered) + "\n"
	}
	fmt.Fprint(os.Stdout, rendered, "\n")
	return 0
}

func main() {
	os.Exit(run(os.Args[1:]))
}
